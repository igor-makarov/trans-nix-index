#!/usr/bin/env bash
# Run inside: mise run nix -- develop --command bash scripts/ci/build ...
set -euo pipefail
if [[ -n "${CACHIX_CACHE:-}" ]]; then
  cachix use "$CACHIX_CACHE"
  if [[ -n "${CACHIX_AUTH_TOKEN:-}" ]]; then
    # Watch individual completed builds, including per-revision extractions,
    # not just the final index (whose closure does not retain build inputs).
    exec cachix watch-exec "$CACHIX_CACHE" -- nix "$@"
  fi
fi
exec nix "$@"
