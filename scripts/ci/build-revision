#!/usr/bin/env bash
set -euo pipefail
source scripts/ci/cachix
: "${PIPELINE_REVISION:?Pass a full revision commit}"
: "${PIPELINE_REVISION_NAME:?Pass the published channel name}"
[[ "$PIPELINE_REVISION" =~ ^[0-9a-f]{40}$ ]]
[[ "$PIPELINE_REVISION_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._+-]*$ ]]
echo "$(date -u +%FT%TZ) revision build start: $PIPELINE_REVISION" >&2
mkdir -p _ci/pure
roots=$(mktemp -d "$PWD/_ci/pure/revision-roots.XXXXXXXX")
result=$(nix build --max-jobs 4 --file nix/revision-build.nix \
  --argstr name "$PIPELINE_REVISION_NAME" --argstr rev "$PIPELINE_REVISION" \
  all --out-link "$roots/result" --print-out-paths -L)
echo "$(date -u +%FT%TZ) revision build complete; upload start" >&2
cache_push "$result"
echo "$(date -u +%FT%TZ) revision upload complete" >&2
