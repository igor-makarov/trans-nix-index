#!/usr/bin/env bash
# Source inside nix develop. No credential is written to the checkout.
set -euo pipefail
cachix use trans-nix-index
# cachix use configures child Nix commands; builders remain sandboxed.
export NIX_CONFIG="${NIX_CONFIG:-}
sandbox = true"
cache_push() {
  if [[ "${PIPELINE_PUBLISH:-true}" == false ]]; then
    echo "Local run: not uploading $1" >&2
    return
  fi
  : "${CACHIX_AUTH_TOKEN:?Set CACHIX_AUTH_TOKEN to publish pipeline outputs}"
  cachix push trans-nix-index "$1"
}
cache_pull() {
  case "$1" in
    /nix/store/*) ;;
    *) echo 'Expected a Nix store path' >&2; return 1 ;;
  esac
  mkdir -p _ci/pure
  local roots
  roots=$(mktemp -d "$PWD/_ci/pure/pull-roots.XXXXXXXX")
  nix-store --realise "$1" --add-root "$roots/result" --indirect >/dev/null
}
