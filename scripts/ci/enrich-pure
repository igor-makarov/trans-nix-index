#!/usr/bin/env bash
# Deliberately impure: cache membership, narinfos, runtime graph and closures.
set -euo pipefail
source scripts/ci/cachix
: "${PIPELINE_RESULT:?Pass the merged revision directory}"
test -d "$PIPELINE_RESULT/index"
export MULTIVERSE_ROOT="$PWD/_ci/pure/enrichment"
export MULTIVERSE_NIX="$PWD/nix"
# Never carry observations from an earlier execution into this snapshot.
rm -rf "$MULTIVERSE_ROOT/index/.outpaths"
mkdir -p "$MULTIVERSE_ROOT/index"
cp "$PIPELINE_RESULT/index/"{revisions,releases}.json "$MULTIVERSE_ROOT/"
cp "$PIPELINE_RESULT/index/"{versions,history,stats}.json "$MULTIVERSE_ROOT/index/"
systems=$(nix eval --json --file nix/revision-systems.nix | python3 -c 'import json,sys; print(",".join(json.load(sys.stdin)))')
if [[ -n "${PIPELINE_ENRICH_SHARDS:-}" ]]; then
  bash scripts/ci/merge-enrichment
else
  bash tools/update-outpaths.sh --full --systems "$systems" \
    --evaluations "$PIPELINE_RESULT/evaluations"
fi
staging=$(mktemp -d "$PWD/_ci/pure/snapshot.XXXXXXXX")
mkdir "$staging/artifacts" "$staging/state"
cp "$PIPELINE_RESULT/index/"*.json "$staging/"
work="$MULTIVERSE_ROOT/index/.outpaths"
cp "$work/data/"{outpaths-,tip-outpaths-,outs-}*.json "$staging/artifacts/"
cp "$work/data/"{info-indexed,refs-indexed,closures,outs-indexed}.json "$staging/artifacts/"
cp "$work/graph.jsonl" "$staging/state/"
shopt -s nullglob
for file in "$work/data/"misses-*.json; do cp "$file" "$staging/state/"; done
python3 tools/snapshot.py "$staging" "$PWD/_ci/pure/enriched-snapshot.tar.gz"
python3 tools/validate-data.py "$staging"
