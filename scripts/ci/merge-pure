#!/usr/bin/env bash
set -euo pipefail
source scripts/ci/cachix
# Shards may have just published paths previously probed as missing locally.
export NIX_CONFIG="${NIX_CONFIG}
narinfo-cache-negative-ttl = 0"
PIPELINE_INPUTS="$PWD/_ci/pure/inputs"
test -f "$PIPELINE_INPUTS/manifest.json"
roots=$(mktemp -d "$PWD/_ci/pure/merge-roots.XXXXXXXX")
python3 tools/prepare-revision-paths.py "$PIPELINE_INPUTS" "$roots/revisions"
nix-instantiate nix/pipeline-build.nix --argstr inputs "$PIPELINE_INPUTS" \
  -A all --add-root "$roots/derivation" >/dev/null
drv=$(readlink -f "$roots/derivation")
python3 tools/prepare-merge.py "$drv" "$roots/inputs"
nix-store --realise "$drv" --add-root "$roots/result" >/dev/null
result=$(readlink -f "$roots/result")
cache_push "$result"
mkdir -p _ci/pure
printf '%s\n' "$result" > _ci/pure/result-path
