#!/usr/bin/env bash
# Shared impure payload/liveness sweep for legacy and Cachix pipelines.
set -euo pipefail
: "${MULTIVERSE_ROOT:?Set the observation work directory}"
work="$MULTIVERSE_ROOT/index/.outpaths"
data="$work/data"
seeds=("$data"/outpaths-*.json "$data"/tip-outpaths-*.json)
python3 tools/census.py --seeds "${seeds[@]}" \
  --out "$work/census-results.json" \
  --graph "$work/graph.jsonl" --date "$(date -u +%F)"
# Census changes liveness only; reconsolidate without re-evaluating nixpkgs.
args=()
if [[ -d "$data/prev-shards" ]]; then args+=(--prev-dir "$data/prev-shards"); fi
if [[ -s "$data/manifest-meta.pkl" ]]; then args+=(--manifest-meta "$data/manifest-meta.pkl"); fi
python3 tools/consolidate-outpaths.py --seeds "${seeds[@]}" \
  --graph "$work/graph.jsonl" "${args[@]}" --out-dir "$data"
