#!/usr/bin/env bash
set -euo pipefail
python3 tools/resolve-data.py _ci/snapshot "$@"
python3 tools/validate-data.py _ci/snapshot
hash=$(nix hash path --sri _ci/snapshot)
nix build --file nix/site-build.nix \
  --argstr snapshot "$PWD/_ci/snapshot" --argstr snapshotHash "$hash" \
  --out-link result-site -L
rm -rf _site
mkdir _site
cp -rL result-site/. _site/
chmod -R a+rX,u+w _site
