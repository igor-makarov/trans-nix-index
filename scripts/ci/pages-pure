#!/usr/bin/env bash
set -euo pipefail
snapshot="$PWD/_ci/pure/pages-snapshot"
test -f "$PWD/_ci/pure/enriched-snapshot.tar.gz"
# Replace only the unpacked input; keep the archive and persistent Nix cache.
rm -rf -- "$snapshot"
PYTHONPATH="$PWD/tools" python3 -c 'import snapshot,sys; snapshot.unpack(sys.argv[1], sys.argv[2])' \
  "$PWD/_ci/pure/enriched-snapshot.tar.gz" "$snapshot"
python3 tools/validate-data.py "$snapshot"
hash=$(nix hash path --sri "$snapshot")
roots=$(mktemp -d "$PWD/_ci/pure/pages-roots.XXXXXXXX")
site=$(nix build --file nix/site-build.nix --argstr snapshot "$snapshot" \
  --argstr snapshotHash "$hash" --out-link "$roots/result" --print-out-paths -L)
rm -rf _site
mkdir _site
cp -rL "$site/." _site/
chmod -R a+rX,u+w _site
SITE_ROOT="$PWD/_site" nix run '.#test-site'
