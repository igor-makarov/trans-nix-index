#!/usr/bin/env bash
# Optional previous enriched output: observation reuse, never an indexing input.
set -euo pipefail
repository="${1:?Pass the pipeline repository}"
digest="${2:-}"
[[ -n "$digest" ]] || exit 0
python3 tools/pipeline-artifact.py pull enriched-snapshot --repository "$repository" \
  --digest "$digest" --path _ci/pure/previous-artifact
PYTHONPATH="$PWD/tools" python3 -c 'import snapshot,sys; snapshot.unpack(sys.argv[1], sys.argv[2])' \
  _ci/pure/previous-artifact/enriched-snapshot.tar.gz _ci/pure/previous/snapshot
